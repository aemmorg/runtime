# Auto-generated by init_packages.py
# All settings (including dependencies) are originally defined in
# {{ package_namespace }}.settings.yaml file, package_dependencies/package_test_dependencies sections
# Do not edit manually — update {{ package_namespace }}.settings.yaml and run init_packages.py to regenerate

[project]
name = "{{ package_name }}"
version = "{{ package_version }}"
description = "{{ package_description }}"
readme = "README.md"
{%- if package_requires_python %}
requires-python = "{{ package_requires_python }}"
{%- endif %}
{% if package_license.startswith("LicenseRef-") -%}
license = "{{ package_license }}"
license-files = ["LICENSE"]
{% else -%}
license = { text = "{{ package_license }}" }
{% endif -%}
authors = [
    { name = "{{ package_authors }}" }
]
{%- if package_classifiers %}
classifiers = [
{% for classifier in package_classifiers %}    "{{ classifier }}",
{% endfor %}]
{%- endif %}
{%- if package_dependencies %}
dependencies = [
{% for dep in package_dependencies %}    "{{ dep }}",
{% endfor %}]
{%- endif %}
{%- if package_urls %}

[project.urls]
{%- for label, url in package_urls.items() %}
"{{ label }}" = "{{ url }}"
{%- endfor %}
{%- endif %}

[tool.hatch.build.targets.wheel]
packages = ["{{ package_path }}"]
exclude = [
    "/tests",
    "/tests.*",
]
{% if package_has_shared_data %}
[tool.hatch.build.targets.wheel.shared-data]
"{{ package_path }}/py.typed" = "{{ package_path }}/py.typed"
{% endif %}
[tool.autoflake]
recursive = true
in-place = true
remove-all-unused-imports = true
ignore-init-module-imports = true
exclude = [".venv", ".git", "__pycache__"]

[tool.black]
line-length = 120
include = '\.pyi?$'
target-version = ['py311']
force-exclude = '''
/(
    \.idea
  | \.git
  | \.mypy_cache
  | \.pytest_cache
  | \.tox
  | \.venv
  | __pycache__
  | _build
  | build
  | dist
)/
'''

[tool.isort]
profile = "black"
line_length = 120
ensure_newline_before_comments = true
no_sections = false
lines_between_sections = 0
force_single_line = true
skip = ["__init__.py"]
known_pytest = ["pytest"]
{% for entry in isort_known_packages %}{{ entry.known_name }} = ["{{ entry.known_namespace }}"]
{% endfor %}{% for entry in isort_known_stubs %}{{ entry.known_name }} = ["{{ entry.known_namespace }}"]
{% endfor %}sections = [
{% for section in isort_sections %}  "{{ section }}"{% if not loop.last %},{% endif %}
{% endfor -%}
]

[build-system]
requires = ["hatchling>=1.21.0"]
build-backend = "hatchling.build"
{%- if package_test_dependencies %}

[dependency-groups]
test = [
{% for dep in package_test_dependencies %}    "{{ dep }}",
{% endfor %}]
{%- endif %}

[tool.ruff.lint]
select = ["D"]
ignore = [
    "D100", "D101", "D102", "D103", "D104", "D105", "D106", "D107",
    "D200", "D202", "D203", "D205", "D212", "D213",
    "D301",
    "D400", "D401", "D402", "D403", "D404",
    "D410", "D411", "D413", "D415", "D417",
]

[tool.pytest.ini_options]
addopts = "-p no:warnings"
asyncio_default_fixture_loop_scope = "function"
pythonpath = ["."]
testpaths = ["tests"]
{% if package_has_mypy %}
[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
disallow_untyped_decorators = true
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
warn_unreachable = true

# Import discovery
namespace_packages = true
explicit_package_bases = true

# Per-module options
[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false
check_untyped_defs = true

[[tool.mypy.overrides]]
module = "setup"
ignore_errors = true

# External package handling
[[tool.mypy.overrides]]
module = [
    "pandas.*",
    "numpy.*"
]
ignore_missing_imports = true
{% endif -%}
