[project]
name = "{{ project_name }}"
version = "2025.1217.0"
description = "{{ package_description }}"
readme = "README.md"
requires-python = ">=3.11"
license = { text = "Apache Software License" }
authors = [
    { name = "The Project Contributors" }
]
classifiers = [
{% for classifier in package_classifiers %}    "{{ classifier }}",
{% endfor %}]
dependencies = [
{% for dep in package_dependencies %}    "{{ dep }}",
{% endfor %}]
[project.urls]
"{{ package_url_label }}" = "{{ package_url }}"

[tool.hatch.build.targets.wheel]
packages = ["cl/{{ package_name }}"]
exclude = [
    "/tests",
    "/tests.*",
]
{% if package_has_shared_data %}
[tool.hatch.build.targets.wheel.shared-data]
"cl/{{ package_name }}/py.typed" = "cl/{{ package_name }}/py.typed"
{% endif %}
[tool.autoflake]
recursive = true
in-place = true
remove-all-unused-imports = true
ignore-init-module-imports = true
exclude = [".venv", ".git", "__pycache__"]

[tool.black]
line-length = 120
include = '\.pyi?$'
target-version = ['py311']
force-exclude = '''
/(
    \.idea
  | \.git
  | \.mypy_cache
  | \.pytest_cache
  | \.tox
  | \.venv
  | __pycache__
  | _build
  | build
  | dist
)/
'''

[tool.isort]
profile = "black"
line_length = 120
ensure_newline_before_comments = true
no_sections = false
lines_between_sections = 0
force_single_line = true
skip = ["__init__.py"]
known_pytest = ["pytest"]
{% for entry in isort_known_packages %}{{ entry.key }} = ["{{ entry.value }}"]
{% endfor %}{% for entry in isort_known_stubs %}{{ entry.key }} = ["{{ entry.value }}"]
{% endfor %}sections = [{% for section in isort_sections %}"{{ section }}"{% if not loop.last %}, {% endif %}{% endfor %}]

[build-system]
requires = ["hatchling>=1.21.0"]
build-backend = "hatchling.build"

[tool.pytest.ini_options]
addopts = "-p no:warnings"
asyncio_default_fixture_loop_scope = "function"
pythonpath = ["."]
testpaths = ["tests"]
{% if package_has_mypy %}
[tool.mypy]
python_version = "3.11"
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
disallow_untyped_decorators = true
no_implicit_optional = true
warn_redundant_casts = true
warn_unused_ignores = true
warn_no_return = true
warn_unreachable = true

# Import discovery
namespace_packages = true
explicit_package_bases = true

# Per-module options
[[tool.mypy.overrides]]
module = "tests.*"
disallow_untyped_defs = false
check_untyped_defs = true

[[tool.mypy.overrides]]
module = "setup"
ignore_errors = true

# External package handling
[[tool.mypy.overrides]]
module = [
    "pandas.*",
    "numpy.*"
]
ignore_missing_imports = true
{% endif %}
