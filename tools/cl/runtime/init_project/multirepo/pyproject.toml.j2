[project]
name = "project"
version = "0.0.0"
description = "Project root for dependency resolution"
requires-python = ">=3.11"
dependencies = [
{% for entry in main_package_entries %}    "{{ entry.name }}",
{% endfor %}]
{%- if combined_test_dependencies %}

[dependency-groups]
test = [
{% for dep in combined_test_dependencies %}    "{{ dep }}",
{% endfor %}]
{%- endif %}

# uv path dependency sources (used by uv pip compile / uv lock)
[tool.uv.sources]
{% for entry in main_package_entries %}{{ entry.name }} = { path = "{{ entry.path }}", editable = true }
{% endfor %}
# Poetry path dependency sources (used by poetry lock / poetry export)
[tool.poetry]
name = "project"
version = "0.0.0"
description = "Project root for dependency resolution"
package-mode = false

[tool.poetry.dependencies]
python = ">=3.11, <4"
{% for entry in main_package_entries %}{{ entry.name }} = { path = "{{ entry.path }}", develop = true }
{% endfor %}

[tool.autoflake]
recursive = true
in-place = true
remove-all-unused-imports = true
ignore-init-module-imports = true
exclude = [".venv", ".git", "__pycache__"]

[tool.black]
line-length = 120
include = '\.pyi?$'
target-version = ['py311']
force-exclude = '''
/(
    \.idea
  | \.git
  | \.mypy_cache
  | \.pytest_cache
  | \.tox
  | \.venv
  | __pycache__
  | _build
  | build
  | dist
)/
'''

[build-system]
requires = ["hatchling>=1.21.0"]
build-backend = "hatchling.build"

[tool.pytest.ini_options]
addopts = "-p no:warnings"
asyncio_default_fixture_loop_scope = "function"
pythonpath = [{% for package_dir in package_dirs %}"{{ package_dir }}"{% if not loop.last %}, {% endif %}{% endfor %}]
testpaths = [{% for package_dir in package_dirs %}"{{ package_dir }}/tests"{% if not loop.last %}, {% endif %}{% endfor %}]
