    def _get_records(
        cls,
        type_to_export: str,
        keys: list[str],
        with_dependencies: bool = False,
    ) -> Sequence[RecordMixin | None]:
        """Fetch records from the database and return them."""

        request_type = TypeInfo.from_type_name(type_to_export)

        keys = set(keys)  # remove duplicates
        key_objs = [
            _KEY_SERIALIZER.deserialize(key, TypeHint.for_type(request_type.get_key_type()))
            for key in keys
        ]
        records = active(DataSource).load_many(key_objs)

        if with_dependencies:
            # using dictionary to remove duplicates
            all_records = {
                str(dependency_record.get_key()): dependency_record
                for dependency_record in DependencyParser(records).get_dependencies()
            }
            # TODO: check the order of records.
            #  1) requested keys should be first in the iteration?
            #  2) missing keys might be allowed to be iterated as None?
            return list(all_records.values())

        return records

    @classmethod
    def _get_records_grouped_by_type(
            cls,
            type_to_export: str,
            keys: list[str],
            with_dependencies: bool = False,
    ) -> dict[type, Iterable[RecordMixin]]:
        """Fetch records from the database and return them grouped by type."""
        records = cls._get_records(type_to_export=type_to_export, keys=keys, with_dependencies=with_dependencies)
        type_to_records = defaultdict(list)
        for record in records:
            if record:
                type_to_records[type(record)].append(record)

        return type_to_records
